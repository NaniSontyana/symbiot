# ------------------------------------------------------------------
# Symbiot ASR Microservice — environment
# Copy to `.env` and adjust. Most values have working defaults.
# ------------------------------------------------------------------

# Service port
PORT=8000

# Engine selection: "parakeet" (real NVIDIA Parakeet Realtime EOU 120M,
# needs `pip install -r requirements.txt` and downloads the model from
# Hugging Face on first run) or "mock" (scripted interviewer simulation,
# zero dependencies — perfect for local demos and CI).
ASR_ENGINE=parakeet
# Shorthand: ASR_MOCK=1 forces the mock engine.

# Parakeet model id or a local .nemo checkpoint path
ASR_MODEL=nvidia/parakeet_realtime_eou_120m-v1

# "cuda" / "cpu" / leave empty for auto
ASR_DEVICE=

# Voice separation for mic-only capture (Streaming Sortformer)
ASR_DIARIZATION=1
ASR_DIAR_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1

# Skip model loading entirely (unit tests)
ASR_SKIP_MODEL_LOAD=0
