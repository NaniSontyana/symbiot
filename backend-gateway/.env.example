# ------------------------------------------------------------------
# Symbiot Backend Gateway — environment
# Copy to `.env` and adjust. All values have working local defaults.
# ------------------------------------------------------------------

# HTTP + WebSocket port
PORT=5000

# PostgreSQL (pgvector recommended). If the server is unreachable the
# gateway automatically falls back to an in-memory store so the app
# stays fully functional for demos.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parakeet_db

# Auth
JWT_SECRET=parakeet_secret

# LLM providers (optional). Resolution order is:
#   per-request key sent by the client -> GROQ_API_KEY -> OPENROUTER_API_KEY -> GEMINI_API_KEY
# With no key at all the built-in offline copilot engine answers, so the
# pipeline works with zero external dependencies.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
